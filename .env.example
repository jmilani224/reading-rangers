# Copy to .env.local for local development. Never commit real values.
# Both values are public by design (RLS protects the data). The service_role key must
# NEVER go in this file or in any VITE_ variable: Vite bundles VITE_ values into the page.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
